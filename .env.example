# Modelo YOLO: yolov8n.pt (rapido) | yolov8s.pt | yolov8m.pt (mas preciso, mas lento)
MODEL_PATH=yolov8n.pt

# --- Rendimiento / uso de CPU ---
# Threads de CPU que usa PyTorch por cada inferencia (no todos los cores)
TORCH_THREADS=4
# Corre la deteccion cada N frames (2 = la mitad de los frames, 3 = un tercio...)
FRAME_SKIP=2
# Tope de fps al que el grabber decodifica el RTSP (0 = sin tope). En CPUs
# debiles, decodificar H264 a 25 fps compite con la inferencia; bajar a ~5-10
# libera CPU para la deteccion a costa de menos frescura del frame.
GRABBER_MAX_FPS=0
# Resolucion a la que se re-escala cada frame antes de pasarlo al modelo
IMGSZ=640
# Padding (%) alrededor del bbox para el recorte de galeria
CROP_PADDING_PERCENT=20

# Diagnostico de conteo: loguea por frame las detecciones, tracker_ids y los
# cruces que registra LineZone. Util si ves la persona cruzar la linea pero el
# contador no suma (1 = activado, 0 = apagado).
COUNTING_DEBUG=0

# Webhook de tu workflow n8n existente (opcional)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/vehicular-count
# Timeout (s) para el POST al webhook (se ejecuta en el worker de
# notificaciones, fuera del hilo de deteccion)
N8N_WEBHOOK_TIMEOUT_SECONDS=5

# Notificaciones por Telegram (opcional). Crear un bot con @BotFather y
# obtener el chat_id hablandole al bot y consultando
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_PHOTO=true
# Timeout (s) para las requests de Telegram (hilo de notificaciones)
TELEGRAM_TIMEOUT_SECONDS=10

# Cola de notificaciones (F3): los reportes n8n/Telegram se ejecutan en un
# worker desacoplado del hilo de deteccion. Estos parametros acotan la cola y
# cuantos hilos la consumen. Si la cola se llena, se descarta la notificacion
# mas reciente (nunca bloquea la deteccion) y se loguea el evento.
NOTIF_QUEUE_SIZE=256
NOTIF_WORKERS=1
# Cada cuanto (s) el reloj horario revisa si cambio la hora para emitir el
# reporte horario aunque una camara este temporalmente sin frames.
HOUR_TICK_SECONDS=1.0

RECONNECT_DELAY_SECONDS=5

# --- Confiabilidad ante colgadas ---
# Timeout (segundos) para la conexion RTSP. Sin esto, un corte de red puede
# dejar el hilo de lectura bloqueado para siempre sin error ni reconexion.
RTSP_TIMEOUT_SECONDS=15
# Watchdog: cada cuanto revisa el estado de las camaras, y cuanto tiempo sin
# frames nuevos antes de reiniciar automaticamente esa camara (conservando
# el conteo entradas/salidas acumulado).
WATCHDOG_INTERVAL_SECONDS=15
WATCHDOG_STALE_SECONDS=60
# Jitter aleatorio (s) para evitar que todos los workers se reinicien juntos
WATCHDOG_JITTER_SECONDS=2
# Intervalo minimo (s) entre reinicios de la misma camara
WATCHDOG_MIN_RESTART_INTERVAL_SECONDS=30
# Maximo reinicios por camara dentro de la ventana (anti-loop)
WATCHDOG_MAX_RESTARTS_PER_WINDOW=3
# Ventana de tiempo (s) para contar reinicios
WATCHDOG_RESTART_WINDOW_SECONDS=300
# Timeout (s) para esperar el stop limpio de un worker
WORKER_STOP_TIMEOUT_SECONDS=5

# --- Ancho de banda del vivo ---
LIVE_JPEG_QUALITY=70
LIVE_MAX_WIDTH=960
LIVE_STREAM_FPS=12

# Puerto donde se sirve la interfaz web (UI + vivo + galeria)
WEB_PORT=8001

# Rutas de datos persistentes dentro del contenedor (no tocar salvo que
# cambies tambien el volumen en docker-compose.yml)
DB_PATH=/app/data/app.db
GALLERY_DIR=/app/data/gallery

# --- Retencion de la galeria (F4.5, opt-in) ---
# 0 = sin retencion automatica (comportamiento por defecto, la galeria crece
# sin limite). Si se configuran, al guardar un recorte se eliminan primero los
# mas antiguos hasta respetar el limite.
# GALLERY_MAX_FILES: tope por cantidad de registros/imagenes (mas antiguos primero).
# GALLERY_MAX_AGE_DAYS: elimina los recortes mas antiguos que esta cantidad de dias.
GALLERY_MAX_FILES=0
GALLERY_MAX_AGE_DAYS=0
# Cada cuanto (minutos) el worker de retencion revisa la galeria. La limpieza
# corre en un thread daemon en background (nunca en el hilo de deteccion).
GALLERY_CLEANUP_INTERVAL_MIN=5

# --- Autenticacion (F5, opt-in) ---
# Clave secreta para firmar sesiones Flask (REQUERIDO para F5+).
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Si se definen WEB_USER y WEB_PASSWORD, la UI, el vivo y las exportaciones
# quedan protegidos por HTTP Basic Auth. Si quedan vacios, la app corre
# abierta (como hasta ahora). Se recomienda habilitarlos en produccion.
# WEB_USER=admin
# WEB_PASSWORD=cambia-este-password
# Rutas que quedan PUBLICAS aunque haya auth (separadas por coma). Por defecto
# nada es publico: el vivo (/stream/...) y la galeria (/gallery/image) pueden
# protegerse o abrirse explicitamente aqui segun el caso de uso.
# WEB_PUBLIC_PATHS=/stream,/gallery/image
# Cookie de sesion secure (solo HTTPS). Activar en produccion con TLS.
SESSION_COOKIE_SECURE=false
# Limite de tiempo (s) para tokens CSRF
WTF_CSRF_TIME_LIMIT=3600
# Rate limit del login (ej: "5 per minute", "10 per minute")
LOGIN_RATE_LIMIT=5 per minute

# --- Streaming MJPEG (F6) ---
# Intervalo (s) de polling del generador del vivo cuando no hay frame nuevo.
# Regula el "keep-alive" minimo del flujo (menor = conecta mas seguido).
STREAM_POLL_INTERVAL=0.05

# --- Streaming HLS (F6) ---
# Duracion (s) de cada segmento .ts
HLS_SEGMENT_TIME=2
# Cuantos segmentos mantener en el playlist .m3u8
HLS_SEGMENTS_LIST=5
# Directorio donde se guardan los segmentos HLS dentro del contenedor
HLS_DIR=/app/data/hls
# Delay (s) antes de reconectar ffmpeg si se cae
HLS_RECONNECT_DELAY=5
# Cada cuanto (min) el worker de limpieza elimina segmentos viejos
HLS_CLEANUP_INTERVAL_MIN=2
# Edad maxima (min) de un segmento antes de ser eliminado
HLS_MAX_AGE_MIN=10

# --- Alertas proactivas (F7.3) ---
# Intervalo (s) entre revisiones de estado de cámaras
ALERT_CHECK_INTERVAL=60
# Minutos sin frames antes de considerar una cámara "caída"
ALERT_CAMERA_DOWN_MINUTES=5
# Intervalo mínimo (s) entre alertas de la misma cámara (anti-spam)
ALERT_MIN_ALERT_INTERVAL=300
