# Modelo YOLO: yolov8n.pt (rapido) | yolov8s.pt | yolov8m.pt (mas preciso, mas lento)
MODEL_PATH=yolov8n.pt

# --- Rendimiento / uso de CPU ---
# Threads de CPU que usa PyTorch por cada inferencia (no todos los cores)
TORCH_THREADS=4
# Corre la deteccion cada N frames (2 = la mitad de los frames, 3 = un tercio...)
FRAME_SKIP=2
# Resolucion a la que se re-escala cada frame antes de pasarlo al modelo
IMGSZ=640

# Webhook de tu workflow n8n existente (opcional)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/vehicular-count

# Notificaciones por Telegram (opcional). Crear un bot con @BotFather y
# obtener el chat_id hablandole al bot y consultando
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_PHOTO=true

RECONNECT_DELAY_SECONDS=5

# --- Confiabilidad ante colgadas ---
# Timeout (segundos) para la conexion RTSP. Sin esto, un corte de red puede
# dejar el hilo de lectura bloqueado para siempre sin error ni reconexion.
RTSP_TIMEOUT_SECONDS=15
# Watchdog: cada cuanto revisa el estado de las camaras, y cuanto tiempo sin
# frames nuevos antes de reiniciar automaticamente esa camara (conservando
# el conteo entradas/salidas acumulado).
WATCHDOG_INTERVAL_SECONDS=15
WATCHDOG_STALE_SECONDS=60

# --- Ancho de banda del vivo ---
LIVE_JPEG_QUALITY=70
LIVE_MAX_WIDTH=960
LIVE_STREAM_FPS=12

# Puerto donde se sirve la interfaz web (UI + vivo + galeria)
WEB_PORT=8001

# Rutas de datos persistentes dentro del contenedor (no tocar salvo que
# cambies tambien el volumen en docker-compose.yml)
DB_PATH=/app/data/app.db
GALLERY_DIR=/app/data/gallery
